# 02 - Variables and arithmetic
name = "Shakil"          # create a variable
age = 20
cgpa = 3.85
is_student = True
show(name, age, cgpa, is_student)

age = 24                 # update it
age += 1                 # same as age = age + 1
show("age:", age)

a = 10
b = 3
show("add:", a + b)
show("subtract:", a - b)
show("multiply:", a * b)
show("divide:", a / b)
show("floor divide:", a // b)
show("modulo:", a % b)
show("power:", a ** b)
