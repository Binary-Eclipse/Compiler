{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" }, { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(when|orwhen|otherwise|each|during|task)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(orwhen|otherwise)\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*(when|orwhen|otherwise|each|during|task)\\b.*:\\s*(#.*)?$", "action": { "indent": "indent" } }
  ]
}
