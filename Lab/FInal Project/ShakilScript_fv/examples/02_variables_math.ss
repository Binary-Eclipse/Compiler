# 02 - Variables and arithmetic
name = "Shakil"          # create a variable
age = 20
cgpa = 3.85
is_student = True
print(name, age, cgpa, is_student)

age = 24                 # update it
age += 1                 # same as age = age + 1
print("age:", age)

a = 10
b = 3
print("add:", a + b)
print("subtract:", a - b)
print("multiply:", a * b)
print("divide:", a / b)
print("floor divide:", a // b)
print("modulo:", a % b)
print("power:", a ** b)
