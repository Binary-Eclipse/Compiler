# type conversion and truthiness
print(int("42"), int("  7 "), int("-3"), int("+5"), int(3.99), int(-3.99), int(True), int())
print(float("3.14"), float("1e3"), float("  2 "), float(7), float(True), float("inf"), float("-inf"), float())
print(str(42), str(3.0), str(True), str(None), str([1, 2]), str("x"), str(-0.5), str())
print(bool(0), bool(1), bool(-1), bool(0.0), bool(0.1), bool(""), bool("False"), bool([]), bool([[]]), bool(None), bool())
print(int("12") + 1, float("1.5") * 2, str(1) + "1", int(str(99)) + 1)
print(1 == 1.0, True == 1, False == 0, "1" == 1, None == None, None == 0, [1] == [1.0])
print(1 / 3, 2 / 3, 10 / 3, 1e300 * 10, -1e300 * 10)
print(100 / 7, 22 / 7, 0.1 * 3, 1.1 + 2.2, 3 * 1.1)
print(1e22, 1.5e300, 5e-324, 123456789012345.6, 1234567890123456.7, 12345678901234567.8)
print(0.5, 0.25, 0.1, 100.0, 1e2, 1.0e-4, 12.5e-5)
print(7 // 2, -7 // 2, 7 // -2, -7 // -2, 7.0 // 2, -7.0 // 2)
print(7 % 3, -7 % 3, 7 % -3, -7 % -3, 7.5 % 2, -7.5 % 2, 5 % 5)
print(2 ** 62, 2 ** 0, 0 ** 0, 3 ** 4, 2.0 ** 3, 4 ** 0.5, 10 ** -2)
print(int("0"), int("007"), float("007.50"), float(".5"), float("5."))
print(max(1, 2.5), min(1, 2.5), max("a", "b"), max([1, 5, 3]), min([4, 2, 8]), max(3, 3.0))
print(sum([1, 2.5]), sum([]), sum([1, 2], 10), sum([True, True]), sum([0.1, 0.2, 0.3]))
print(abs(-0.0), abs(True), -(-5), +5, -(5 - 8))
