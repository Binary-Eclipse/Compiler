// ShakilScript: basic language demonstration
print("Welcome to ShakilScript!");
create("name", "Shakil");
create("age", 24);
print(get("name"));
print(get("age"));
print(add(10, 5));
print(subtract(10, 5));
print(multiply(10, 5));
print(divide(10, 4));
print(modulo(10, 3));
update("age", 25);
print(get("age"));
